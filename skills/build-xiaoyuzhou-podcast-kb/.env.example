# Never commit a real key. Copy this file to ~/.config/build-xiaoyuzhou-podcast-kb/.env.
DASHSCOPE_API_KEY=
# Qwen-Audio 3.0 file transcription normally uses a workspace-scoped base URL.
# Example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
ASR_POLL_SECONDS=5
ASR_MAX_WAIT_SECONDS=14400
ASR_MAX_RETRIES=5
MAX_EPISODES_PER_RUN=5
